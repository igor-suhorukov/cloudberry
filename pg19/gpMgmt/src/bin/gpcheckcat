def getCatObj(namestr):
    db = connect2(GV.cfg[GV.coordinator_dbid], utilityMode=False)
    try:
        cat = GV.catalog.getCatalogTable(namestr)
    except Exception as e:
        myprint("No such catalog table: %s\n" % str(namestr))
        raise
    return cat


