#!/usr/bin/env python3
#
# Ported to PostgreSQL 19: the port's copy of gpMgmt/bin/gpcheckcat
# (pg19/gpMgmt/meson.build).  Cloudberry's checks compare each catalog's rows
# on the coordinator with gp_dist_random('<catalog>'), which its planner
# reads on the segments through a Motion, only the columns the query uses.
# The port's gp_dist_random() gathers whole rows through libpq, and a value
# of some catalog columns' types -- attmissingval's anyarray, a node tree --
# cannot be read back; so a segment's rows are read through
# gp_internal.segment_query(), which runs a query of gp_dist_random() on each
# segment and sends only its columns, each such one as its text
# (segmentRows()), and the coordinator's own rows are read in the same
# columns (coordinatorRows()) where Cloudberry made a temporary table of them
# distributed by segment.  A check of one node's catalog runs on each node
# over a connection of its own, as before, without utility mode, which
# PostgreSQL 19 has not: a connection straight to a segment is the segment's
# own.  The host is PGHOST's where it is set, as libpq's is.  The catalog is
# PostgreSQL 19's and the port's (gppylib/gpcatalog.py): every node gives an
# object the coordinator's OID (R1), so its rows are compared by OID; a
# node's temporary schemas and what is in them, and an incremental view's
# triggers, are the node's own and left out of the comparisons
# (PORT_EXCLUDE); Cloudberry's own catalogs are views, labels and tables of
# the port's modules, so the checks of pg_appendonly's auxiliary relations
# and gp_fastsequence are the port's checks of what it has instead --
# gp_ao's segment files (aoseg_table, Cloudberry's name), PAX's aux tables
# (pax_aux) and directory tables' files (directory_table) -- and the "gp"
# labels, a table's distribution, are pg_seclabel's rows, compared with the
# rest.  Leaked temporary schemas are reported, not dropped
# (gpcheckcat_modules/leaked_schema_dropper.py).  PyGreSQL 6 counts a
# result's rows with len() and gives an aclitem[] as its text, so the ACLs
# are asked for as text[]; the version is the port's (gpversion.VERSION_SQL).
'''
Usage: gpcheckcat [<option>] [dbname]

    -? | --help              : help menu
    -B parallel              : number of worker threads
    -g dir                   : generate SQL to rectify catalog corruption, put it in dir
    -p port                  : DB port number
    -P passwd                : DB password
    -U uname                 : DB User Name
    -v                       : verbose
    -A                       : all databases
    -S option                : shared table options (none, only)
    -O                       : Online
    -l                       : list all tests
    -R test | 'test1, test2' : run this particular test(s) (quoted, comma seperated list for multiple tests)
    -s test | 'test1, test2' : skip this particular test(s) (quoted, comma seperated list for multiple tests)
    -C catname               : run cross consistency, FK and ACL tests for this catalog table
    -x                       : set session level GUCs

    Test subset options are mutually exclusive, use only one of '-R', '-s', or '-C'.

'''
import datetime
import getopt
import logging
import re
import sys
import time
from functools import reduce

try:
    from gppylib import gplog
    from gppylib.db import dbconn
    from gppylib.gpcatalog import *
    from gppylib.commands.unix import *
    from gppylib.commands.gp import conflict_with_gpexpand
    from gppylib.system.info import *
    from gppylib.gpversion import VERSION_SQL
    from pgdb import DatabaseError
    from gpcheckcat_modules.unique_index_violation_check import UniqueIndexViolationCheck
    from gpcheckcat_modules.leaked_schema_dropper import LeakedSchemaDropper
    from gpcheckcat_modules.repair import Repair
    from gpcheckcat_modules.foreign_key_check import ForeignKeyCheck
    from gpcheckcat_modules.orphaned_toast_tables_check import OrphanedToastTablesCheck

    import pg

except ImportError as e:
    sys.exit('Error: unable to import module: ' + str(e))

# cache OID -> object name cache
oidmap = {}

