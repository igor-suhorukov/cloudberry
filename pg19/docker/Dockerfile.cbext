#
# The port's modules, built against the patched PostgreSQL 19, and stock
# PostGIS beside them.
#
# This tree arrives as a read-only build context named "cbsrc", and the build
# takes the branch out of it with "git archive", so the build never sees an
# unclean working tree.  Set CB_REF to build something other than the port
# branch.  PostGIS is cloned from upstream at a tag, and the commit the tag
# points at is checked; see POSTGIS_TAG.

ARG PG_IMAGE=cloudberry/pg19-patched:latest
ARG CB_REF=extension_postgresql_19
# PostGIS 3.7 is the first release line for PostgreSQL 19, and 3.7.0rc2 is its
# newest tag.  The commit is checked, so the image is built from the source
# cloudberry.md cites and not from whatever the tag has been moved to since.
ARG POSTGIS_TAG=3.7.0rc2
ARG POSTGIS_COMMIT=e2ea03ad0bfcf4b15ccb748113be3c5741809a08

###############################################################################
FROM ${PG_IMAGE} AS pg
###############################################################################

###############################################################################
FROM debian:trixie-slim AS postgis
###############################################################################
# Stock PostGIS, built against the patched server exactly as it would be
# against a vanilla one: PGXS, found through pg_config, with no patch to
# PostGIS and nothing of the port's on its include path.  The stage depends
# only on the server image, so rebuilding the modules does not rebuild it.
ARG POSTGIS_TAG
ARG POSTGIS_COMMIT
USER root

# GEOS, PROJ, libxml2 and json-c are PostGIS's own; GDAL is raster's;
# protobuf-c is ST_AsMVT's and ST_AsGeobuf's.  autoconf and libtool are for
# autogen.sh, and bison and flex for the WKT parser, because the source is a
# git tree rather than a release tarball, which ships them generated.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential pkg-config git ca-certificates autoconf automake libtool \
        bison flex \
        libxml2-dev libgeos-dev libproj-dev libgdal-dev libjson-c-dev \
        libprotobuf-c-dev protobuf-c-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pg /usr/local/pgsql /usr/local/pgsql
ENV PATH=/usr/local/pgsql/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/pgsql/lib:/usr/local/pgsql/lib/x86_64-linux-gnu

RUN git clone --quiet --depth 1 --branch "$POSTGIS_TAG" \
        https://github.com/postgis/postgis.git /postgis \
 && test "$(git -C /postgis rev-parse HEAD)" = "$POSTGIS_COMMIT" \
 && echo "$POSTGIS_COMMIT" > /postgis/.postgis_commit

WORKDIR /postgis
RUN ./autogen.sh > /dev/null \
 && ./configure --with-pgconfig=/usr/local/pgsql/bin/pg_config > configure.log \
 && make -j"$(nproc)" > make.log \
 && make install DESTDIR=/postgis-root > install.log

# PostGIS's own regression suite, for the postgis_regress suite.  It runs
# from the build tree -- run_test.pl, the tests and the loaders it calls are
# all there -- over the tests, flags and hook scripts this build's configure
# chose, which make assembles from the tests.mk files.  They are written out
# here, as make would pass them to run_test.pl for "make installcheck", so the
# suite needs no make: flags, then hook scripts, then tests, a line each.
RUN make -C topology/test check-regress-deps > /dev/null \
 && printf 'print-regress:\n\t@echo "$(RUNTESTFLAGS)"\n\t@echo "$(RUNTESTFLAGS_INTERNAL)"\n\t@echo "$(TESTS)"\n' \
        | make -s -f GNUmakefile -f - print-regress RUNTESTFLAGS=--extension \
        > regress/port-regress.txt \
 && test "$(wc -l < regress/port-regress.txt)" = 3

###############################################################################
FROM debian:trixie-slim AS build
###############################################################################
ARG CB_REF
USER root

# libxerces-c-dev is ORCA's: its intermediate form, DXL, is XML, and the
# parser and serializer are written against xerces.  g++ comes with
# build-essential; ORCA is C++17.  libcurl is gp_exttable's, for gpfdist://
# and http:// locations; APR, libevent and libyaml are gpfdist's.  Protocol
# buffers and liburing are PAX's: its files' footers and statistics are
# protobuf messages, and its reader reads a file's groups through io_uring;
# C++'s protocol buffers are gp_stats_collector's too, whose messages to its
# agent are protobuf's.
# bison and flex are gp_resource's, for Cloudberry's io_limit grammar, which
# a resource group's io_limit is read with.  jansson is gpfts's, with
# libcurl: Cloudberry's etcd client speaks JSON to etcd's gateway.  libxml2,
# OpenSSL and libcurl are gpcloud's too, the S3 protocol's: S3's answers are
# XML, and a request is signed with OpenSSL's HMAC; and libcurl is
# pxf_fdw's, PXF's client.  libuv is the interconnect module's: the proxy's
# server, Cloudberry's ic-proxy, is written on it.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential meson ninja-build pkg-config git ca-certificates bison flex \
        libreadline-dev zlib1g-dev libicu-dev libssl-dev liblz4-dev libzstd-dev \
        libxml2-dev libxslt1-dev libxerces-c-dev \
        libcurl4-openssl-dev libapr1-dev libevent-dev libyaml-dev libjansson-dev \
        protobuf-compiler libprotobuf-dev liburing-dev \
        libuv1-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pg /usr/local/pgsql /usr/local/pgsql
ENV PATH=/usr/local/pgsql/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/pgsql/lib:/usr/local/pgsql/lib/x86_64-linux-gnu

WORKDIR /cb
RUN --mount=type=bind,from=cbsrc,target=/cbsrc,ro \
    git -C /cbsrc archive "$CB_REF" | tar -x -C /cb

# tabulate, the header-only library PAX's dump functions print through
# (pax/meson.build): a git submodule of Cloudberry's tree, which git archive
# leaves out, cloned at the commit the tree's submodule names.
RUN --mount=type=bind,from=cbsrc,target=/cbsrc,ro \
    commit="$(git -C /cbsrc ls-tree "$CB_REF" contrib/pax_storage/src/cpp/contrib/tabulate | awk '{print $3}')" \
 && test -n "$commit" \
 && git clone --quiet https://github.com/p-ranav/tabulate.git /cb/contrib/pax_storage/src/cpp/contrib/tabulate \
 && git -C /cb/contrib/pax_storage/src/cpp/contrib/tabulate checkout --quiet "$commit" \
 && rm -rf /cb/contrib/pax_storage/src/cpp/contrib/tabulate/.git

# ... and googletest, which PAX's unit tests are written with, the same way:
# the test-only module pax_gtest runs them (pax/meson.build).
RUN --mount=type=bind,from=cbsrc,target=/cbsrc,ro \
    commit="$(git -C /cbsrc ls-tree "$CB_REF" contrib/pax_storage/src/cpp/contrib/googletest | awk '{print $3}')" \
 && test -n "$commit" \
 && git clone --quiet https://github.com/google/googletest.git /cb/contrib/pax_storage/src/cpp/contrib/googletest \
 && git -C /cb/contrib/pax_storage/src/cpp/contrib/googletest checkout --quiet "$commit" \
 && rm -rf /cb/contrib/pax_storage/src/cpp/contrib/googletest/.git

# The modules are built against the installed PostgreSQL, found through
# pg_config.  Configuration fails if that PostgreSQL does not carry the core
# patch series, which is the point: the modules are written against it.
RUN meson setup /cb/build /cb/pg19 \
        -Dpg_config=/usr/local/pgsql/bin/pg_config \
        --prefix=/usr/local/pgsql \
 && ninja -C /cb/build \
 && ninja -C /cb/build install

# PostgreSQL's own regression suite, for the suites that run it against the
# port.  From the commit the server was built from, read out of the server
# image, so the tests cannot be of another commit than the binaries under
# them; and its C module built against the installed server, as an extension
# would be, beside the two contrib modules its tests load from the same
# directory.
RUN --mount=type=bind,from=pgsrc,target=/pgsrc,ro \
    mkdir -p /pgregress \
 && git -C /pgsrc archive "$(cat /usr/local/pgsql/.pg_ref_commit)" src/test/regress \
        | tar -x -C /pgregress --strip-components=3 \
 && cd /pgregress \
 && printf '%s\n' 'MODULES = regress' 'PG_CONFIG = /usr/local/pgsql/bin/pg_config' \
        'PGXS := $(shell $(PG_CONFIG) --pgxs)' 'include $(PGXS)' > Makefile.pgxs \
 && make -f Makefile.pgxs > /dev/null \
 && cp "$(pg_config --pkglibdir)/autoinc.so" "$(pg_config --pkglibdir)/refint.so" . \
 && cp /usr/local/pgsql/.pg_ref_commit /pgregress/.pg_ref_commit

# The two programs Cloudberry's parallel retrieve cursor schedule runs
# (isolation2's parallel_retrieve_cursor/extended_query), which retrieve
# over the extended query protocol, built as its isolation2 Makefile builds
# them, against the installed libpq, into the suite's directory, where the
# test runs them from.  The second opens its sessions of the segments with
# "-c gp_role=utility", which PostgreSQL 19 has no such setting for, and
# which a connection to a segment is here anyway: without it, as the
# isolation2 harness runs the tests' own commands.
RUN cd /cb/src/test/isolation2 \
 && for p in test_parallel_retrieve_cursor_extended_query \
             test_parallel_retrieve_cursor_extended_query_error; do \
        sed 's/"-c gp_role=utility"/NULL/' "$p.c" > "/tmp/$p.c" \
     && cc -I"$(pg_config --includedir)" -o "$p" "/tmp/$p.c" \
           -L"$(pg_config --libdir)" -Wl,-rpath,"$(pg_config --libdir)" -lpq \
     || exit 1; \
    done

###############################################################################
FROM ${PG_IMAGE} AS runtime
###############################################################################
USER root
# gp_orca links against xerces-c, so the runtime image needs the library even
# though it does not need the headers; the rest are the libraries of the
# PostGIS stage's -dev packages.  perl is the whole of it, not perl-base:
# Cloudberry's gpdiff.pl and PostGIS's run_test.pl are the port's test
# drivers, and each wants modules perl-base leaves out.  diffutils for
# pg_regress, whose diff the suites wrap.  Python with PyGreSQL for
# Cloudberry's isolation2 driver, sql_isolation_testcase.py.  gp_exttable's
# libcurl and gpfdist's libraries, and curl, with which Cloudberry's external
# table tests wait for the gpfdist they start.  procps for pgrep, with which
# Cloudberry's diskquota tests look for the launcher and its workers.
# libprotobuf and liburing are PAX's, and libprotobuf gp_stats_collector's
# too.  gpMgmt, the management tools meson installs beside the server, needs
# psutil, PyYAML and pexpect besides PyGreSQL, and the commands its scripts
# run on each host: ip and ss, ping, rsync and less; and fakeroot, with which
# gppkg installs a package's debs into GPHOME by dpkg.  gpfts needs jansson
# beside libcurl, and the gpfts suite an etcd, which it starts: Debian's, 3.5.
# libxml2 is gpcloud's; and moto's S3 server, with Flask, which it serves
# through, and boto3, which it brings, the S3 the gpcloud suite runs
# Cloudberry's tests against.  python3-venv for DuckDB's, below.  libuv is
# the interconnect module's, its proxy's.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libxerces-c3.2 libxml2 \
        libcurl4t64 libapr1t64 libevent-2.1-7t64 libyaml-0-2 curl \
        libjansson4 etcd-server \
        libprotobuf32t64 liburing2 \
        libuv1t64 \
        libgeos-c1t64 libproj25 libgdal36 libjson-c5 libprotobuf-c1 \
        perl diffutils procps \
        python3 python3-pygresql python3-venv \
        python3-psutil python3-yaml python3-pexpect iproute2 iputils-ping rsync less \
        fakeroot \
        python3-moto python3-flask python3-flask-cors \
    && rm -rf /var/lib/apt/lists/*
# One locale beyond C: a function of Cloudberry's AOCO_Compression sets
# lc_monetary to en_US.utf8, which its test machines have.
RUN sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen && locale-gen
# DuckDB, for the tpc suite: its tpch and tpcds extensions generate TPC-H's
# and TPC-DS's data, give their queries, and answer each as the suite's
# reference (pg19/test/tpc).  Pinned, in a venv of its own, and the two
# extensions installed with it where every user reads them, so that the
# suite runs without the network.
ARG DUCKDB_VERSION=1.5.5
RUN python3 -m venv /opt/duckdb \
    && /opt/duckdb/bin/pip install --no-cache-dir "duckdb==${DUCKDB_VERSION}" \
    && /opt/duckdb/bin/python -c "import duckdb; c = duckdb.connect(config={'extension_directory': '/opt/duckdb/extensions'}); c.execute('INSTALL tpch'); c.execute('INSTALL tpcds')" \
    && chmod -R a+rX /opt/duckdb
# The whole prefix, rather than lib/ and share/extension/ separately: where
# PostgreSQL puts its data files depends on the prefix -- $prefix/share when
# the prefix ends in "pgsql" or "postgres", $prefix/share/postgresql when it
# does not -- so naming the subdirectories here would tie this file to one
# prefix.  The build stage installed the modules into the same tree, and
# PostGIS was installed under the same prefix, beneath a DESTDIR.
COPY --from=build /usr/local/pgsql /usr/local/pgsql
COPY --from=postgis /postgis-root/usr/local/pgsql /usr/local/pgsql
COPY --from=postgis /postgis/.postgis_commit /usr/local/pgsql/.postgis_commit
# The test harness is run from the image, so it comes along -- and so do the
# test suites of Cloudberry's that the port's suites run, with the Perl that
# compares their output, and PostgreSQL's own regression suite.
COPY --from=build /cb/pg19/test /cb/pg19/test
COPY --from=build /cb/src/test/regress/gpdiff.pl /cb/src/test/regress/atmsort.pm \
                  /cb/src/test/regress/explain.pm /cb/src/test/regress/GPTest.pm.in \
                  /cb/src/test/regress/init_file \
                  /cb/src/test/regress/
# Cloudberry's own regression suite, its greenplum_schedule, part of which
# the greenplum suite runs on a cluster: the tests, their expected output and
# the data they read.
COPY --from=build /cb/src/test/regress/greenplum_schedule /cb/src/test/regress/
# and the script bb_memory_quota runs, many sessions at once
COPY --from=build /cb/src/test/regress/mem_quota_util.py /cb/src/test/regress/
COPY --from=build /cb/src/test/regress/sql /cb/src/test/regress/sql
COPY --from=build /cb/src/test/regress/expected /cb/src/test/regress/expected
COPY --from=build /cb/src/test/regress/input /cb/src/test/regress/input
COPY --from=build /cb/src/test/regress/output /cb/src/test/regress/output
COPY --from=build /cb/src/test/regress/data /cb/src/test/regress/data
# and what rowhints pipes its plans through, sql/maskout.sh, a link there to
# Cloudberry's pg_hint_plan
COPY --from=build /cb/gpcontrib/pg_hint_plan/sql/maskout.sh /cb/gpcontrib/pg_hint_plan/sql/
COPY --from=build /cb/src/test/singlenode_regress /cb/src/test/singlenode_regress
COPY --from=build /cb/src/test/singlenode_isolation2 /cb/src/test/singlenode_isolation2
COPY --from=build /cb/src/test/isolation2 /cb/src/test/isolation2
# Cloudberry's diskquota tests, which the diskquota suite runs: its two
# schedules, their tests and expected output, and its init file.
COPY --from=build /cb/gpcontrib/diskquota/tests /cb/gpcontrib/diskquota/tests
# Cloudberry's PAX tests, which the pax suite runs: pax_schedule, its tests
# and expected output, and PAX's init file.
COPY --from=build /cb/contrib/pax_storage/pax_schedule /cb/contrib/pax_storage/init_file \
                  /cb/contrib/pax_storage/
COPY --from=build /cb/contrib/pax_storage/sql /cb/contrib/pax_storage/sql
COPY --from=build /cb/contrib/pax_storage/expected /cb/contrib/pax_storage/expected
# and PAX's own copies of Cloudberry's regression and isolation2 suites,
# which the pax_regress and pax_isolation2 suites run
COPY --from=build /cb/contrib/pax_storage/src/test/regress /cb/contrib/pax_storage/src/test/regress
COPY --from=build /cb/contrib/pax_storage/src/test/isolation2 /cb/contrib/pax_storage/src/test/isolation2
# pxf_fdw's tests, which the pxf_fdw suite runs; and gpcloud's, which the
# gpcloud suite runs: its unit tests' data, its regression schedule, and the
# server one of its tests starts.
COPY --from=build /cb/gpcontrib/pxf_fdw/sql /cb/gpcontrib/pxf_fdw/sql
COPY --from=build /cb/gpcontrib/pxf_fdw/expected /cb/gpcontrib/pxf_fdw/expected
COPY --from=build /cb/gpcontrib/gpcloud/test/data /cb/gpcontrib/gpcloud/test/data
COPY --from=build /cb/gpcontrib/gpcloud/regress /cb/gpcontrib/gpcloud/regress
COPY --from=build /cb/gpcontrib/gpcloud/bin/dummyHTTPServer.py /cb/gpcontrib/gpcloud/bin/
# datalake_fdw's three tests, its automation's smoke category, which the
# datalake_fdw suite runs; and gp_stats_collector's eight, which the suite
# of that name runs.
COPY --from=build /cb/contrib/datalake_fdw/test/automation/sqlrepo/smoke/iceberg_am \
                  /cb/contrib/datalake_fdw/test/automation/sqlrepo/smoke/iceberg_am
COPY --from=build /cb/gpcontrib/gp_stats_collector/sql /cb/gpcontrib/gp_stats_collector/sql
COPY --from=build /cb/gpcontrib/gp_stats_collector/expected /cb/gpcontrib/gp_stats_collector/expected
COPY --from=build /pgregress /cb/pgregress
COPY --from=postgis /postgis /postgis
RUN chown -R postgres:postgres /cb /postgis
USER postgres
WORKDIR /cb
CMD ["postgres"]
