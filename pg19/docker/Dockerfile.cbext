#
# The port's modules, built against the patched PostgreSQL 19.
#
# This tree arrives as a read-only build context named "cbsrc", and the build
# takes the branch out of it with "git archive", so the build never sees an
# unclean working tree.  Set CB_REF to build something other than the port
# branch.

ARG PG_IMAGE=cloudberry/pg19-patched:latest
ARG CB_REF=extension_postgresql_19

###############################################################################
FROM ${PG_IMAGE} AS pg
###############################################################################

###############################################################################
FROM debian:trixie-slim AS build
###############################################################################
ARG CB_REF
USER root

# libxerces-c-dev is ORCA's: its intermediate form, DXL, is XML, and the
# parser and serializer are written against xerces.  g++ comes with
# build-essential; ORCA is C++17.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential meson ninja-build pkg-config git ca-certificates \
        libreadline-dev zlib1g-dev libicu-dev libssl-dev liblz4-dev libzstd-dev \
        libxml2-dev libxslt1-dev libxerces-c-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pg /usr/local/pgsql /usr/local/pgsql
ENV PATH=/usr/local/pgsql/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/pgsql/lib:/usr/local/pgsql/lib/x86_64-linux-gnu

WORKDIR /cb
RUN --mount=type=bind,from=cbsrc,target=/cbsrc,ro \
    git -C /cbsrc archive "$CB_REF" | tar -x -C /cb

# The modules are built against the installed PostgreSQL, found through
# pg_config.  Configuration fails if that PostgreSQL does not carry the core
# patch series, which is the point: the modules are written against it.
RUN meson setup /cb/build /cb/pg19 \
        -Dpg_config=/usr/local/pgsql/bin/pg_config \
        --prefix=/usr/local/pgsql \
 && ninja -C /cb/build \
 && ninja -C /cb/build install

###############################################################################
FROM ${PG_IMAGE} AS runtime
###############################################################################
USER root
# gp_orca links against xerces-c, so the runtime image needs the library even
# though it does not need the headers.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libxerces-c3.2 \
    && rm -rf /var/lib/apt/lists/*
# The whole prefix, rather than lib/ and share/extension/ separately: where
# PostgreSQL puts its data files depends on the prefix -- $prefix/share when
# the prefix ends in "pgsql" or "postgres", $prefix/share/postgresql when it
# does not -- so naming the subdirectories here would tie this file to one
# prefix.  The build stage installed the modules into the same tree.
COPY --from=build /usr/local/pgsql /usr/local/pgsql
# The test harness is run from the image, so it comes along.
COPY --from=build /cb/pg19/test /cb/pg19/test
RUN chown -R postgres:postgres /cb
USER postgres
WORKDIR /cb
CMD ["postgres"]
