#
# The port's binary release: the patched PostgreSQL 19 and the port's
# modules, built to run rather than to be tested, and packed by
# pg19/release/package.sh as Debian packages and tarballs.  The workflow
# .github/workflows/pg19-release.yml builds it on each distribution and
# architecture it releases for, and the same command builds it here:
#
#   docker buildx build -f pg19/docker/Dockerfile.release \
#       --build-context pgsrc=../postgres --build-context cbsrc=. \
#       --build-arg BASE_IMAGE=debian:trixie-slim \
#       --output type=local,dest=dist pg19/docker
#
# and pg19/release/smoke.sh installs what it made on a clean system of the
# same distribution and starts a server with every module.
#
# Both repositories arrive as read-only build contexts, and the build takes
# its trees out of them with "git archive", as Dockerfile.pg and
# Dockerfile.cbext do, so that what is released is always a commit.
#
# How it differs from the images the port is tested in: no assertions, no
# injection points and none of docker/patches, which serve the tests alone,
# and the test-only modules left out (-Dhook_tests=false); the features
# those images build with are named, not detected, so that a distribution
# that lacks one fails the build instead of releasing a server without it;
# the libraries are in $prefix/lib on every architecture, where Debian's
# multiarch default would put them in lib/<triplet>; and the debug
# information goes to a package of its own.

ARG BASE_IMAGE=debian:trixie-slim

###############################################################################
FROM ${BASE_IMAGE} AS build
###############################################################################
ARG PG_REF=REL_19_STABLE_CLOUDBERRY
ARG CB_REF=extension_postgresql_19
# The release's version and who it is from, for the packages; package.sh
# says what an empty VERSION gives.
ARG VERSION=
ARG MAINTAINER="igor-suhorukov <igor-suhorukov@users.noreply.github.com>"

# The packages of Dockerfile.pg's and Dockerfile.cbext's build stages, which
# say what each is for, and dpkg-dev for package.sh.  Neither the TAP tests'
# Perl modules nor googletest: nothing here runs a test.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential meson ninja-build pkg-config bison flex perl python3 python3-dev git \
        ca-certificates gettext tzdata dpkg-dev \
        libreadline-dev zlib1g-dev libicu-dev libssl-dev liblz4-dev libzstd-dev \
        libxml2-dev libxslt1-dev libldap-dev \
        libxerces-c-dev libcurl4-openssl-dev libapr1-dev libevent-dev libyaml-dev \
        libjansson-dev protobuf-compiler libprotobuf-dev liburing-dev libuv1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN --mount=type=bind,from=pgsrc,target=/pgsrc,ro \
    git -C /pgsrc archive "$PG_REF" | tar -x -C /src \
 && git -C /pgsrc rev-parse "$PG_REF" > /src/.pg_ref_commit

# The features are Dockerfile.pg's, and only those: this stage also has the
# modules' libraries installed, and detection would take libcurl and liburing
# for the server as well.  Installed twice: under DESTDIR for its package,
# and in place, for the modules to build against.
RUN meson setup build --prefix=/usr/local/pgsql --libdir=lib \
        --buildtype=debugoptimized --auto-features=disabled \
        -Dcassert=false -Dinjection_points=false \
        -Dssl=openssl -Dicu=enabled -Dlz4=enabled -Dzstd=enabled -Dzlib=enabled \
        -Dreadline=enabled -Dlibxml=enabled -Dlibxslt=enabled -Dnls=enabled \
        -Dplpython=enabled -Dldap=enabled \
 && ninja -C build \
 && DESTDIR=/stage/postgresql ninja -C build install > /dev/null \
 && ninja -C build install > /dev/null \
 && cp /src/.pg_ref_commit /stage/postgresql/usr/local/pgsql/.pg_ref_commit

WORKDIR /cb
RUN --mount=type=bind,from=cbsrc,target=/cbsrc,ro \
    git -C /cbsrc archive "$CB_REF" | tar -x -C /cb \
 && git -C /cbsrc rev-parse "$CB_REF" > /cb/.cb_ref_commit

# tabulate, which PAX's dump functions print through, cloned as
# Dockerfile.cbext clones it, at the commit the tree's submodule names.
RUN --mount=type=bind,from=cbsrc,target=/cbsrc,ro \
    commit="$(git -C /cbsrc ls-tree "$CB_REF" contrib/pax_storage/src/cpp/contrib/tabulate | awk '{print $3}')" \
 && test -n "$commit" \
 && git clone --quiet https://github.com/p-ranav/tabulate.git /cb/contrib/pax_storage/src/cpp/contrib/tabulate \
 && git -C /cb/contrib/pax_storage/src/cpp/contrib/tabulate checkout --quiet "$commit" \
 && rm -rf /cb/contrib/pax_storage/src/cpp/contrib/tabulate/.git

# The parts the port builds where their libraries are, named, for the same
# reason as the server's features; ORCA's debug checks off, as they are
# wherever the server's assertions are.
RUN meson setup /cb/build /cb/pg19 \
        -Dpg_config=/usr/local/pgsql/bin/pg_config --prefix=/usr/local/pgsql \
        -Dhook_tests=false -Dorca_debug=disabled \
        -Dgpfdist=enabled -Dgpfts=enabled -Dic_proxy=enabled \
 && ninja -C /cb/build \
 && DESTDIR=/stage/extension ninja -C /cb/build install > /dev/null \
 && cp /cb/.cb_ref_commit /stage/extension/usr/local/pgsql/.cb_ref_commit

RUN VERSION="$VERSION" MAINTAINER="$MAINTAINER" bash /cb/pg19/release/package.sh /stage /dist

###############################################################################
FROM scratch AS dist
###############################################################################
COPY --from=build /dist/ /
