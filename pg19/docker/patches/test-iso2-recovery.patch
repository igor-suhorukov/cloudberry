+	/*
+	 * A test may raise an error here, the transaction ended for the other
+	 * backends, which has AbortTransaction() run again.
+	 */
+	INJECTION_POINT("abort_after_procarray_end", NULL);
+
 	/*
 	 * Post-abort cleanup.  See notes in CommitTransaction() concerning
 	 * ordering.  We can skip all of it if the transaction failed before
