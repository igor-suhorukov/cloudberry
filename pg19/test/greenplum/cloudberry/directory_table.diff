+ dttablespace | oid  |           |          |         | plain    | 
+View definition:
+ SELECT c.oid AS dtrelid,
+        CASE c.reltablespace
+            WHEN 0 THEN ( SELECT d.dattablespace
+               FROM pg_database d
+              WHERE d.datname = current_database())
+            ELSE c.reltablespace
+        END AS dttablespace,
+    l.location AS dtlocation
+   FROM pg_class c
