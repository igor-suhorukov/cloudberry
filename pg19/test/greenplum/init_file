-- The port's additions to Cloudberry's init_file, read by gpdiff.pl after it.

-- start_matchignore

# ORCA's line, as gp_orca prints it; Cloudberry's init_file masks the planner's
# and "Pivotal Optimizer (GPORCA)".
m/^ Optimizer: GPORCA$/

-- end_matchignore

-- start_matchsubs

# An error a segment raised names the segment in its DETAIL, and where it
# listens, which is another socket and port on every run.  Where the error
# has no detail of its own, the segment named is the one whose failure the
# coordinator heard first, which varies from run to run when several can
# fail -- a function in the segments' slice, called on each one's rows -- and
# so does how many others failed too: both are masked, as Cloudberry's
# init_file masks its "(seg0 slice1 ...)".
m/^DETAIL:  segment \d+ \([^)]*\)(; \d+ other segments failed too)?$/
s/^DETAIL:  segment \d+ \([^)]*\)(; \d+ other segments failed too)?$/DETAIL:  segment/
m/^DETAIL:  segment \d+ \(.*?\)/
s/^DETAIL:  segment (\d+) \(.*?\)/DETAIL:  segment $1/

# Cloudberry's init_file drops "set enable_parallel = off;" and its reset,
# which its tests carry and its expected files do not; the harness has
# respelled them as the port spells the setting (gp_settings.c).
m/set gp\.enable_parallel = off;/
s/.//gs
m/reset gp\.enable_parallel;/
s/.//gs

-- end_matchsubs
