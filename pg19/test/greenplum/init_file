-- The port's additions to Cloudberry's init_file, read by gpdiff.pl after it.

-- start_matchignore

# ORCA's line, as gp_orca prints it; Cloudberry's init_file masks the planner's
# and "Pivotal Optimizer (GPORCA)".
m/^ Optimizer: GPORCA$/

# The footer Cloudberry's psql gives \d of a table, which PostgreSQL 19's
# psql, the one the suite runs, does not: psql asks its own catalogs, and
# has no hook to be told the port's.  What it says is in
# gp_distribution_policy, which the tests read too.
m/^Distributed (by: \(.*\)|randomly|Replicated)$/

# An error a segment raised names the segment in a DETAIL of its own where
# the error has none: which segment it was, and where it listens, as
# Cloudberry's names it after its message, "(seg0 slice1 ...)", which
# Cloudberry's init_file takes away.  So does this, the line with it.
m/^DETAIL:  segment \d+ \([^)]*\)(; \d+ other segments failed too)?$/

# PostgreSQL 19's ANALYZE VERBOSE ends each relation with what it cost --
# the time, the reads, the WAL -- where PostgreSQL 16's, Cloudberry's, said
# nothing: one INFO of several lines, each of them numbers of the run's.
m/^INFO:  finished analyzing table "/
m/^avg read rate: [0-9.]+ MB\/s, avg write rate: [0-9.]+ MB\/s$/
m/^buffer usage: \d+ hits, \d+ reads, \d+ dirtied$/
m/^WAL usage: \d+ records, \d+ full page images, \d+ bytes, /
m/^system usage: CPU: user: /
m/^I\/O timings: read: /
m/^delay time: /

-- end_matchignore

-- start_matchsubs

# The prefix psql gives a message of a file a test includes, which the
# harness has it include from the group's suite, converted and respelled
# (run.sh's include_files()): Cloudberry's init_file takes away its own,
# psql:sql/<file>:<line>.
m/^psql:\S+\/include\/sql\/[\w.]+:\d+: /
s/^psql:\S+\/include\/sql\/[\w.]+:\d+: //

# Where an error a segment raised has a detail of its own, that detail is
# Cloudberry's DETAIL, and the segment and the count before and after it go,
# as the "(seg0 ...)" after Cloudberry's message goes.
m/^DETAIL:  segment \d+ \([^)]*\): /
s/^DETAIL:  segment \d+ \([^)]*\): (.*?)(; \d+ other segments failed too)?$/DETAIL:  $1/

# A fault's error, which ends with a space in Cloudberry's words as in the
# port's (faultinjector.c), and without it in Cloudberry's expected files.
m/^ERROR:  fault triggered, fault name:'\w+' fault type:'\w+' $/
s/ $//

# The segment a gather of a replicated table reads, which EXPLAIN names:
# the session's backend's (gp_scan.c, GpScanReplicatedContent()), which
# changes from run to run, in a plan gpdiff.pl compares as rows.
m/^\s+Segment: \d+\s*$/
s/Segment: \d+/Segment: N/

# Cloudberry's init_file drops "set enable_parallel = off;" and its reset,
# which its tests carry and its expected files do not; the harness has
# respelled them as the port spells the setting (gp_settings.c).
m/set gp\.enable_parallel = off;/
s/.//gs
m/reset gp\.enable_parallel;/
s/.//gs

# gp_toolkit.__gp_aoblkdir()'s tupleid, where a row of a table's block
# directory is: gp_ao keeps every table's rows in one table, so the place
# depends on the tables written before, where Cloudberry's is in the table's
# own pg_aoblkdir relation.  The column -- its values, its header and the
# rule under that, whose width follows them -- is made one.
m/^ gp_segment_id \| tupleid +\| segno \| columngroup_no \| entry_no \| first_row_no \| file_offset \| row_count $/
s/tupleid +\|/tupleid |/
m/^-{15}\+-+\+-{7}\+-{16}\+-{10}\+-{14}\+-{13}\+-{11}$/
s/^(-{15}\+)-+\+/$1---------+/
m/^ +\d+ \| \(\d+,\d+\) +\| +\d+ \| +\d+ \| +\d+ \| +\d+ \| +\d+ \| +\d+$/
s/\| \(\d+,\d+\) +\|/| (tid)   |/

# An error's LINE in a statement that names a data file of Cloudberry's by
# its absolute path, cut short inside the path: what is left of the part
# before src/test/regress/ is the harness's directory here and Cloudberry's
# there, which only the length of the line makes the same.
m/^LINE \d+: \.\.\.\S*\/src\/test\/regress\/data\//
s/^(LINE \d+: \.\.\.)\S*(\/src\/test\/regress\/data\/)/$1$2/

# namespace_gp's OIDs of the built-in schemas: gp_ao's pg_bitmapindex is an
# extension's schema, with an OID of its own, which the objects made before
# it decide -- Cloudberry's is 7012, from its catalog.  The difference that
# is left is kept (cloudberry/namespace_gp.diff).
m/^ +\d+ \| pg_bitmapindex$/
s/^ +\d+ \|/ OID |/

-- end_matchsubs
