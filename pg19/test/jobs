#
# The jobs run.sh makes of the suites, and how long each takes: run.sh starts
# the longest first.  A suite not listed is one job, started last.
#
#   suite   job ("-" when the suite is one)   seconds   environment
#
# A suite that runs its tests under the planner and under ORCA is one job a
# pass, and diskquota's, pax's and resgroup's a job a group of their tests
# too, resgroup's each on a cgroup parent of its own (resgroup/run.sh).
# ALONE=1 jobs run after the rest, side by side with each other alone:
# resgroup's test that measures a group's share of the CPU, each pass on
# half the cores (CPUS).  The seconds are a run's, on the machine the port is
# built on (16 cores, 32 threads), with every job at once; they order the
# jobs and nothing else, and run.sh's summary gives each run's own.

resgroup               orca_cpu 110   PASSES=orca RG_GROUPS=cpu ALONE=1 CPUS=16-31
resgroup               planner_cpu 110 PASSES=planner RG_GROUPS=cpu ALONE=1 CPUS=0-15
resgroup               orca_cpuset 90 PASSES=orca RG_GROUPS=cpuset
resgroup               planner_cpuset 90 PASSES=planner RG_GROUPS=cpuset
resgroup               orca     115   PASSES=orca RG_GROUPS=main
resgroup               planner  110   PASSES=planner RG_GROUPS=main
greenplum              orca     396   PASSES=orca
diskquota              regress  170   DQ_PARTS=regress DQ_GROUP=main
diskquota              ctas     115   DQ_PARTS=regress DQ_GROUP=ctas
diskquota              ctas_spc 110   DQ_PARTS=regress DQ_GROUP=ctas_spc
greenplum              planner  290   PASSES=planner
singlenode             orca     263   PASSES=orca
pax                    toast    130   PAX_GROUP=toast
pax                    -         60   PAX_GROUP=main
isolation2             orca     145   PASSES=orca
postgis_regress        orca     144   PASSES=orca
isolation2             planner  143   PASSES=planner
diskquota              isolation2 138   DQ_PARTS=isolation2
gpmgmt                 -        120
