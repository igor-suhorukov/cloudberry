#
# The jobs run.sh makes of the suites, and how long each takes: run.sh starts
# the longest first.  A suite not listed is one job, started last.
#
#   suite   job ("-" when the suite is one)   seconds   environment
#
# A suite that runs its tests under the planner and under ORCA is one job a
# pass -- but resgroup, whose tests read the cgroups under
# /sys/fs/cgroup/gpdb by name, and so run one cluster at a time: its two
# passes are one job, which runs alone (ALONE=1), after the rest, since its
# CPU tests take every core in a cgroup that outweighs the other jobs'.  The seconds are a run's, on the machine the port is
# built on (16 cores, 32 threads), with every job at once; they order the
# jobs and nothing else, and run.sh's summary gives each run's own.

resgroup               -        555   ALONE=1
greenplum              orca     390   PASSES=orca
diskquota              regress  339   DQ_PARTS=regress
greenplum              planner  288   PASSES=planner
singlenode             orca     258   PASSES=orca
pax                    -        161
isolation2             orca     146   PASSES=orca
isolation2             planner  144   PASSES=planner
postgis_regress        orca     138   PASSES=orca
