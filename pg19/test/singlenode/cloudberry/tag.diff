+                     View "pg_catalog.pg_tag_description"
+    Column    | Type | Collation | Nullable | Default | Storage  | Description 
+--------------+------+-----------+----------+---------+----------+-------------
+ oid          | oid  |           |          |         | plain    | 
+ tagid        | oid  |           |          |         | plain    | 
+ tagvalue     | text |           |          |         | extended | 
+ tdclassid    | oid  |           |          |         | plain    | 
+ tddatabaseid | oid  |           |          |         | plain    | 
+ tdobjid      | oid  |           |          |         | plain    | 
+View definition:
+ SELECT NULL::oid AS oid,
+    ( SELECT db.oid
+           FROM pg_database db
+          WHERE db.datname = current_database()) AS tddatabaseid,
+    l.classoid AS tdclassid,
+    l.objoid AS tdobjid,
+    t.oid AS tagid,
+    d.value #>> '{}'::text[] AS tagvalue
+   FROM pg_seclabel l
+     CROSS JOIN LATERAL jsonb_each(l.label::jsonb) d(key, value)
+     JOIN gp_sql.tag_definitions() t(oid, tagname, tagowner, allowed_values) ON t.tagname = d.key
+  WHERE l.provider = 'gp_tag'::text AND l.objsubid = 0
+UNION ALL
+ SELECT NULL::oid AS oid,
+    0::oid AS tddatabaseid,
+    l.classoid AS tdclassid,
+    l.objoid AS tdobjid,
+    t.oid AS tagid,
+    d.value #>> '{}'::text[] AS tagvalue
+   FROM pg_shseclabel l
+     CROSS JOIN LATERAL jsonb_each(l.label::jsonb) d(key, value)
+     JOIN gp_sql.tag_definitions() t(oid, tagname, tagowner, allowed_values) ON t.tagname = d.key
+  WHERE l.provider = 'gp_tag'::text
+UNION ALL
+ SELECT NULL::oid AS oid,
+    ( SELECT db.oid
+           FROM pg_database db
+          WHERE db.datname = current_database()) AS tddatabaseid,
+    'pg_class'::regclass::oid AS tdclassid,
+    i.indexrelid AS tdobjid,
+    t.oid AS tagid,
+    i.tagvalue
+   FROM gp_sql.index_tag i
+     JOIN gp_sql.tag_definitions() t(oid, tagname, tagowner, allowed_values) ON t.tagname = i.tagname;
