-- The port's additions to Cloudberry's singlenode init_file, read by
-- gpdiff.pl after it.

-- start_matchignore

# ORCA's line, as gp_orca prints it; Cloudberry's init_file masks the planner's
# and "Pivotal Optimizer (GPORCA)".
m/^ Optimizer: GPORCA$/

# PostgreSQL 19's ANALYZE VERBOSE ends each relation with what it cost --
# the time, the reads, the WAL -- where PostgreSQL 16's, Cloudberry's, said
# nothing: one INFO of several lines, each of them numbers of the run's, as
# the greenplum suite's init_file has it.
m/^INFO:  finished analyzing table "/
m/^avg read rate: [0-9.]+ MB\/s, avg write rate: [0-9.]+ MB\/s$/
m/^buffer usage: \d+ hits, \d+ reads, \d+ dirtied$/
m/^WAL usage: \d+ records, \d+ full page images, \d+ bytes, /
m/^system usage: CPU: user: /
m/^I\/O timings: read: /
m/^delay time: /

-- end_matchignore

-- start_matchsubs

# An access method's OID, where a test prints one: partition's rows of
# mpp5992 and its relam.  Cloudberry's ao_column is 7166 in its catalog; the
# port's is whatever gp_ao's CREATE EXTENSION was given, which differs from
# run to run.  Masked on both sides.
m/^ mpp5992\w* +\| +\d+ \| *(FOR VALUES .*)?$/
s/\| +\d+ \|/| relam |/

# Cloudberry's init_file drops "set enable_parallel = off;" and its reset,
# which its tests carry and its expected files do not; the harness has
# respelled them as the port spells the setting (gp_settings.c).
m/set gp\.enable_parallel = off;/
s/.//gs
m/reset gp\.enable_parallel;/
s/.//gs

# A fault's error, which ends with a space in Cloudberry's words as in the
# port's (faultinjector.c), and without it in Cloudberry's expected files.
m/^ERROR:  fault triggered, fault name:'\w+' fault type:'\w+' $/
s/ $//

-- end_matchsubs
