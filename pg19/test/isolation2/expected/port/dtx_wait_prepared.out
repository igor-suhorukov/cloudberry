-- Segment 0 refuses every COMMIT PREPARED.  The INSERT commits: its second
-- phase there is tried again for half a minute, and left to the recovery
-- process.  Segment 0 holds the part prepared; segment 1 has committed its
-- own.
SELECT gp_inject_fault_infinite('finish_prepared_start_of_function', 'error', dbid) FROM gp_segment_configuration WHERE role = 'p' AND content = 0;
 gp_inject_fault_infinite 
--------------------------
 Success:                 
(1 row)
