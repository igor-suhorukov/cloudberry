-- The port's own: a segment's statement waits for a part the segment holds
-- prepared when its distributed snapshot says the transaction committed
-- (gp_dtx.c, dtx_snapshot_arrived()).  The coordinator sends COMMIT
-- PREPARED before its transaction ends for the other sessions (O33), so no
-- snapshot sees one committed while a segment still holds its part -- but
-- for a part its second phase did not reach: one a segment refuses for the
-- half minute the coordinator tries it again, which the coordinator leaves
-- to its recovery process, its commit standing.  Cloudberry's distributed
-- snapshot shows such a transaction in progress until every segment has
-- answered, so none of Cloudberry's tests meets the wait.
--
-- And the recovery process, which the coordinator wakes as it gives up,
-- finishes that part at once, though its latch was reset before it looked:
-- here it is held at a fault, which resets it, after a round of its own --
-- one that leaves a part younger than gp.dtx_recovery_prepared_period
-- alone, as the round after it would, were the wake lost.

-- Until a backend of this node waits for a transaction's lock.
CREATE FUNCTION dtx_wait_transactionid() RETURNS bool AS $$ BEGIN	/* in func */ FOR i IN 1..600 LOOP	/* in func */ IF EXISTS (SELECT FROM pg_stat_activity WHERE wait_event_type = 'Lock' AND wait_event = 'transactionid') THEN	/* in func */ RETURN true;	/* in func */ END IF;	/* in func */ PERFORM pg_sleep(0.1);	/* in func */ PERFORM pg_stat_clear_snapshot();	/* in func */ END LOOP;	/* in func */ RETURN false;	/* in func */ END;	/* in func */ $$ LANGUAGE plpgsql;
CREATE

-- Until this node holds no prepared part, for at most secs seconds.
CREATE FUNCTION dtx_wait_no_prepared(secs int) RETURNS bool AS $$ BEGIN	/* in func */ FOR i IN 1..secs * 10 LOOP	/* in func */ IF NOT EXISTS (SELECT FROM pg_prepared_xacts) THEN	/* in func */ RETURN true;	/* in func */ END IF;	/* in func */ PERFORM pg_sleep(0.1);	/* in func */ END LOOP;	/* in func */ RETURN false;	/* in func */ END;	/* in func */ $$ LANGUAGE plpgsql;
CREATE

CREATE TABLE dtx_wait_prepared (a int, b int) DISTRIBUTED BY (a);
CREATE

-- The recovery process rounds every second while the test sets it up, and
-- is held at its fault as one of its own rounds begins -- after a timeout,
-- not a wake, which would have it take everything.
ALTER SYSTEM SET gp.dtx_recovery_interval = 1;
ALTER
SELECT pg_reload_conf();
