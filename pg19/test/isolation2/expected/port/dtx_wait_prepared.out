-- Segment 0 takes it again, and the recovery process goes on: the part is
-- committed at once, and the statement reads all twenty rows.
SELECT gp_inject_fault('finish_prepared_start_of_function', 'reset', dbid) FROM gp_segment_configuration WHERE role = 'p' AND content = 0;
