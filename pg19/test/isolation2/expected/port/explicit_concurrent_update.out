DELETE 1
2&: MERGE INTO ec_t USING ec_s ON ec_t.c2 = ec_s.c2 WHEN MATCHED THEN UPDATE SET c1 = ec_t.c1 + 1;  <waiting ...>
1: COMMIT;
COMMIT
2<:  <... completed>
MERGE 0
