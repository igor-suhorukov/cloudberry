-- A row whose new version the plan no longer gives -- by the condition the
-- gather sends the segment, or by the join's -- is passed over: UPDATE 0,
-- as PostgreSQL's
1: BEGIN;
BEGIN
1: UPDATE ec_t SET c1 = 1000 WHERE c2 = 1;
UPDATE 1
2&: UPDATE ec_t SET c1 = ec_t.c1 + 1 FROM ec_s WHERE ec_t.c2 = ec_s.c2 AND ec_t.c1 < 1000;  <waiting ...>
1: COMMIT;
COMMIT
2<:  <... completed>
UPDATE 0
1: BEGIN;
BEGIN
1: UPDATE ec_t SET c2 = 2 WHERE c2 = 1;
UPDATE 1
2&: UPDATE ec_t SET c1 = ec_t.c1 + 1 FROM ec_s WHERE ec_t.c2 = ec_s.c2;  <waiting ...>
1: COMMIT;
COMMIT
2<:  <... completed>
UPDATE 0
1: SELECT * FROM ec_t;
 c1   | c2 
------+----
 1000 | 2  
(1 row)
