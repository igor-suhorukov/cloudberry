-- At REPEATABLE READ the segment's statement fails itself, as before
1: BEGIN;
BEGIN
1: UPDATE ec_t SET c1 = c1 + 1 WHERE c2 = 1;
UPDATE 1
2: BEGIN ISOLATION LEVEL REPEATABLE READ;
BEGIN
2&: UPDATE ec_t SET c1 = ec_t.c1 + 1 FROM ec_s WHERE ec_t.c2 = ec_s.c2;  <waiting ...>
1: COMMIT;
COMMIT
2<:  <... completed>
ERROR:  could not serialize access due to concurrent update
DETAIL:  segment 1 (/tmp/cbi2-OF4EEK/gdd3:7628)
2: END;
END
