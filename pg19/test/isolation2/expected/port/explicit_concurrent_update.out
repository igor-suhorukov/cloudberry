1: CREATE FUNCTION ec_skip() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF old.c1 >= 100 THEN RETURN NULL; END IF; RETURN new; END $$;
CREATE
1: CREATE TRIGGER ec_skip BEFORE UPDATE ON ec_t FOR EACH ROW EXECUTE FUNCTION ec_skip();
CREATE
