 2     | 20        
 3     | 40        
 4     | 50        
(4 rows)
SELECT segno, sum(tupcount) AS totalrows FROM gp_toolkit.__gp_aoseg('ao_blkdir_test_rowcount') WHERE segment_id = 0 GROUP BY segno;
 segno | totalrows 
-------+-----------
 1     | 10        
 2     | 20        
 3     | 40        
 4     | 50        
(4 rows)

