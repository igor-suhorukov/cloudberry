   ->  Gather Motion 3:1 on vacuum_concurrent_test_@amname@  (slice1; segments: 3) 
         Segments: 3                                                             
 Optimizer: Postgres query optimizer                                             
(5 rows)
-- end_ignore
select * from vacuum_concurrent_test_@amname@ order by b;
 a | b  | c  
---+----+----
