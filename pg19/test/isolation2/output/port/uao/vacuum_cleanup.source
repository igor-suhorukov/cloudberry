-- The port's own: Cloudberry's uao/vacuum_cleanup for gp_ao's layout.
--
-- Cloudberry's test reads the age of relfrozenxid of a table's auxiliary
-- relations -- its pg_aoseg, visimap and block directory tables, by their
-- relkinds and the table's OID in their names -- and its segment files
-- through pg_appendonly.segrelid.  gp_ao keeps every table's segment files,
-- visibility map and block directory in tables of its own that all tables
-- share (gp_ao.segfile, gp_ao.visimap, gp_ao.blkdir), ordinary tables that
-- autovacuum freezes as it does any; and an append-optimized table itself
-- has no relfrozenxid, here as in Cloudberry.  So the ages are not here,
-- and the segment files are read with gp_toolkit's functions.
--
-- The fault of VACUUM's last phase, which recycles what the VACUUM
-- compacted, is set on the segments: each compacts and recycles for itself
-- within the one statement the coordinator sends, where Cloudberry's
-- coordinator sends each phase and has the fault itself.
--
-- And a file compacted while another session is inside a transaction that
-- read the table and is idle is recycled as the VACUUM ends, where
-- Cloudberry keeps it awaiting drop for that transaction's first snapshot
-- (../../cloudberry/README, the first entry): the "reader before VACUUM"
-- below finds its rows where they went.

-- A VACUUM beside a transaction that read the table and holds its
-- AccessShareLock: it compacts, and the reader reads on.
2: create table ao_@amname@_vacuum_cleanup2(a int, b int) using @amname@;
CREATE
2: insert into ao_@amname@_vacuum_cleanup2 select i, i from generate_series(1, 100) i;
INSERT 100
2: update ao_@amname@_vacuum_cleanup2 set b = b + 1;
UPDATE 100
2: update ao_@amname@_vacuum_cleanup2 set b = b + 1;
UPDATE 100
2: update ao_@amname@_vacuum_cleanup2 set b = b + 1;
UPDATE 100
2: update ao_@amname@_vacuum_cleanup2 set b = b + 1;
UPDATE 100
2: update ao_@amname@_vacuum_cleanup2 set b = b + 1;
UPDATE 100

-- An append-optimized table has no relfrozenxid, on any node.
1: select relfrozenxid, relminmxid from pg_class where relname = 'ao_@amname@_vacuum_cleanup2';
 relfrozenxid | relminmxid 
--------------+------------
 0            | 0          
(1 row)
1: select distinct relfrozenxid, relminmxid from gp_dist_random('pg_class') where relname = 'ao_@amname@_vacuum_cleanup2';
 relfrozenxid | relminmxid 
--------------+------------
 0            | 0          
(1 row)

2: begin;
BEGIN
2: select count(*) from ao_@amname@_vacuum_cleanup2;
 count 
-------
 100   
(1 row)
1: vacuum ao_@amname@_vacuum_cleanup2;
VACUUM
1: select segno, state, sum(tupcount) as tupcount from gp_ao_or_aocs_seg('ao_@amname@_vacuum_cleanup2') group by 1, 2 order by 1;
 segno | state | tupcount 
-------+-------+----------
 1     | 1     | 0        
 2     | 1     | 100      
(2 rows)
2: select count(*), sum(b) from ao_@amname@_vacuum_cleanup2;
 count | sum  
-------+------
 100   | 5550 
(1 row)
2: end;
END

-- Check that drop phase is not skipped, when there are concurrent serializable transactions.
1: create table ao_@amname@_vacuum_cleanup3(a int, b int) using @amname@;
CREATE
1: insert into ao_@amname@_vacuum_cleanup3 select i, i from generate_series(1, 100) i;
INSERT 100
1: delete from ao_@amname@_vacuum_cleanup3;
DELETE 100

1: select gp_inject_fault_infinite('vacuum_relation_open_relation_during_drop_phase', 'suspend', dbid) from gp_segment_configuration where role = 'p' and content >= 0;
 gp_inject_fault_infinite 
--------------------------
 Success:                 
 Success:                 
 Success:                 
(3 rows)
1&: vacuum ao_@amname@_vacuum_cleanup3;  <waiting ...>

-- Wait till compaction phase is completed on every segment and only then
-- start the serializable transaction to ensure that only drop phase runs
-- after the serializable transaction started: the transaction sees the
-- compaction committed and would not access AWAITING_DROP segfiles, so
-- dropping the dead segfiles could proceed accordingly.
2: select gp_wait_until_triggered_fault('vacuum_relation_open_relation_during_drop_phase', 1, dbid) from gp_segment_configuration where role = 'p' and content >= 0;
 gp_wait_until_triggered_fault 
-------------------------------
 Success:                      
 Success:                      
 Success:                      
(3 rows)
2: begin isolation level serializable;
BEGIN
2: select * from ao_@amname@_vacuum_cleanup3;
 a | b 
---+---
(0 rows)
2: select gp_inject_fault('vacuum_relation_open_relation_during_drop_phase', 'reset', dbid) from gp_segment_configuration where role = 'p' and content >= 0;
 gp_inject_fault 
-----------------
 Success:        
 Success:        
 Success:        
(3 rows)

1<:  <... completed>
VACUUM

-- Validate that the drop phase wasn't skipped: segfile 1 should be in state 1
-- (DEFAULT) and empty.
-- This result is related to data distribution.
-- Current hash algorithm is jump-consistent-hash.
1: SELECT * FROM gp_ao_or_aocs_seg('ao_@amname@_vacuum_cleanup3') ORDER BY 1, 2;
 segment_id | segno | tupcount | modcount | formatversion | state 
------------+-------+----------+----------+---------------+-------
 0          | 1     | 0        | 2        | 3             | 1     
 0          | 2     | 0        | 0        | 3             | 1     
 1          | 1     | 0        | 2        | 3             | 1     
 1          | 2     | 0        | 0        | 3             | 1     
 2          | 1     | 0        | 2        | 3             | 1     
 2          | 2     | 0        | 0        | 3             | 1     
(6 rows)

2: commit;
COMMIT

1q: ... <quitting>
2q: ... <quitting>

-- Test VACUUM with concurrent readers:
-- a) if reader transaction started before VACUUM and is idle, at READ
--    COMMITTED, VACUUM drops the segment it compacted all the same -- the
--    reader holds no snapshot, and its next statement's sees the compaction
--    -- where Cloudberry's VACUUM should not;
-- b) if reader transaction started after VACUUM, VACUUM should drop the AWAITING_DROP segments.

create or replace function show_aoseg(tabname text) returns table (segno int, tupcount bigint, modcount bigint, formatversion smallint, state smallint) as $$ select segno, tupcount, modcount, formatversion, state from gp_ao_or_aocs_seg(tabname::regclass) where segment_id = 0 /* in func */ $$ language sql;
CREATE

create table vacuum_concurrent_test_@amname@ (a int, b int, c int) using @amname@;
CREATE
insert into vacuum_concurrent_test_@amname@ select 2, b, b from generate_series(1, 11) b;
INSERT 11
create index i_b_vacuum_concurrent_reader_@amname@ on vacuum_concurrent_test_@amname@(b);
CREATE
update vacuum_concurrent_test_@amname@ set b = b + 1;
UPDATE 11

-- expect segment state is DEFAULT (state == 1)
select * from show_aoseg('vacuum_concurrent_test_@amname@') order by segno;
 segno | tupcount | modcount | formatversion | state 
-------+----------+----------+---------------+-------
 1     | 22       | 2        | 3             | 1     
(1 row)

-- start a reader before VACUUM
1: begin;
BEGIN
1: select * from vacuum_concurrent_test_@amname@ where b = 10;
 a | b  | c 
---+----+---
 2 | 10 | 9 
(1 row)

vacuum vacuum_concurrent_test_@amname@;
VACUUM

-- expect no AWAITING_DROP(state == 2) tuple: the reader holds no snapshot
select * from show_aoseg('vacuum_concurrent_test_@amname@') order by segno;
 segno | tupcount | modcount | formatversion | state 
-------+----------+----------+---------------+-------
 1     | 0        | 2        | 3             | 1     
 2     | 11       | 0        | 3             | 1     
(2 rows)

1: select * from vacuum_concurrent_test_@amname@ where b = 5;
 a | b | c 
---+---+---
 2 | 5 | 4 
(1 row)
1: select * from vacuum_concurrent_test_@amname@ order by c;
 a | b  | c  
---+----+----
 2 | 2  | 1  
 2 | 3  | 2  
 2 | 4  | 3  
 2 | 5  | 4  
 2 | 6  | 5  
 2 | 7  | 6  
 2 | 8  | 7  
 2 | 9  | 8  
 2 | 10 | 9  
 2 | 11 | 10 
 2 | 12 | 11 
(11 rows)
1: end;
END

-- start another reader after VACUUM
2: begin;
BEGIN
2: select * from vacuum_concurrent_test_@amname@ where c = 2;
 a | b | c 
---+---+---
 2 | 3 | 2 
(1 row)

-- expect no AWAITING_DROP(state == 2) tuple still
select * from show_aoseg('vacuum_concurrent_test_@amname@') order by segno;
 segno | tupcount | modcount | formatversion | state 
-------+----------+----------+---------------+-------
 1     | 0        | 2        | 3             | 1     
 2     | 11       | 0        | 3             | 1     
(2 rows)

vacuum vacuum_concurrent_test_@amname@;
VACUUM

-- expect no AWAITING_DROP(state == 2) tuple, and nothing for this VACUUM to do
select * from show_aoseg('vacuum_concurrent_test_@amname@') order by segno;
 segno | tupcount | modcount | formatversion | state 
-------+----------+----------+---------------+-------
 1     | 0        | 2        | 3             | 1     
 2     | 11       | 0        | 3             | 1     
(2 rows)

2: select * from vacuum_concurrent_test_@amname@ where b = 7;
 a | b | c 
---+---+---
 2 | 7 | 6 
(1 row)
2: select * from vacuum_concurrent_test_@amname@ order by c;
 a | b  | c  
---+----+----
 2 | 2  | 1  
 2 | 3  | 2  
 2 | 4  | 3  
 2 | 5  | 4  
 2 | 6  | 5  
 2 | 7  | 6  
 2 | 8  | 7  
 2 | 9  | 8  
 2 | 10 | 9  
 2 | 11 | 10 
 2 | 12 | 11 
(11 rows)
2: end;
END

1q: ... <quitting>
2q: ... <quitting>

-- Test VACUUM with concurrent writer.
-- There was a concurrent insert transaction started prior to VACUUM, VACUUM should not mark
-- the target segment which was also writting by the concurrent writer to AWAITING_DROP, and
-- the corresponding index entries should not be deleted.

truncate table vacuum_concurrent_test_@amname@;
TRUNCATE
insert into vacuum_concurrent_test_@amname@ select 2, b, b from generate_series(1, 5) b;
INSERT 5
delete from vacuum_concurrent_test_@amname@;
DELETE 5

1: begin;
BEGIN
1: insert into vacuum_concurrent_test_@amname@ select 2, b, b from generate_series(6, 10) b;
INSERT 5

2: vacuum vacuum_concurrent_test_@amname@;
VACUUM

1: commit;
COMMIT

set enable_seqscan = on;
SET
-- start_ignore
explain (costs off) select * from vacuum_concurrent_test_@amname@ order by b;
