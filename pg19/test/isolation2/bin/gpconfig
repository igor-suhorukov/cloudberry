# gpconfig as far as the tests the port runs ask it, on the harness's
# cluster: gpconfig -c <name> -v <value> [-m <value>] [--skipvalidation] sets
# a setting on every node the coordinator's gp_segment_configuration lists,
# standby and mirrors included -- on the coordinator alone with
# --masteronly, and to -m's value there where it is given -- for the next
# start or reload, where the harness writes its own, postgresql.auto.conf,
# whose last word is the one taken; a name that is no setting of the
# server's, which would keep a node from starting, is refused, as
# Cloudberry's gpconfig refuses a name it does not know; gpconfig -r <name>
# takes it out again; and gpconfig -s <name> shows it, the coordinator's and
# the segments', as Cloudberry's does, failing for a setting there is none
# of.  Cloudberry's name is the port's (GP_SETTINGS_MAP, from the harness:
# gp_autostats_mode is gp.autostats_mode).  Cloudberry's own gpconfig is
# gpMgmt's, which is M7's.  The greenplum suite runs it too.
set -u

name=; value=; cvalue=; remove=0; show=0; where=
while [ "$#" -gt 0 ]; do
	case "$1" in
		-c) name="$2"; shift 2 ;;
		-r) name="$2"; remove=1; shift 2 ;;
		-s) name="$2"; show=1; shift 2 ;;
		-v) value="$2"; shift 2 ;;
		-m) cvalue="$2"; shift 2 ;;
		--skipvalidation) shift ;;
		--masteronly|--coordinatoronly) where="WHERE content = -1 AND role = 'p'"; shift ;;
		*) echo "gpconfig: this harness's gpconfig does not take $1" >&2; exit 2 ;;
	esac
done
[ -n "$name" ] && { [ -n "$value" ] || [ "$remove" -eq 1 ] || [ "$show" -eq 1 ]; } ||
	{ echo "usage: gpconfig -c name -v value | -r name | -s name [--skipvalidation] [--masteronly]" >&2; exit 2; }

cbname="$name"
if [ -n "${GP_SETTINGS_MAP:-}" ]; then
	mapped=$(awk -v n="$name" '$1 == n { print $2; exit }' "$GP_SETTINGS_MAP")
	[ -n "$mapped" ] && name="$mapped"
fi
value="${value#\'}"; value="${value%\'}"
cvalue="${cvalue#\'}"; cvalue="${cvalue%\'}"

# A setting the server knows is one PostgreSQL's or a module's, gp.* here;
# a name of neither, without a dot, is no setting at all.
if [ "$remove" -eq 0 ] && [ "$show" -eq 0 ] && [[ "$name" != *.* ]] &&
   [ -z "$("$PG_BINDIR/psql" -X -q -t -A -d postgres \
		   -c "SELECT 1 FROM pg_settings WHERE name = '$name'" 2> /dev/null)" ]; then
	echo "gpconfig: not a valid GUC: $cbname" >&2
	exit 1
fi

# -s: the coordinator's value and the segments', in Cloudberry's words
if [ "$show" -eq 1 ]; then
	coord=$("$PG_BINDIR/psql" -X -q -t -A -d postgres \
			-c "SELECT setting FROM pg_settings WHERE name = '$name'" 2> /dev/null)
	[ -n "$coord" ] || { echo "[CRITICAL]:-not a valid GUC: $cbname"; exit 1; }
	segs=$("$PG_BINDIR/psql" -X -q -t -A -d postgres \
		   -c "SELECT DISTINCT result FROM gp.exec_on_segments('SELECT setting FROM pg_settings WHERE name = ''$name''')" 2> /dev/null)
	if [ "$(echo "$segs" | wc -l)" -eq 1 ] && [ "$segs" = "$coord" ]; then
		echo "Values on all segments are consistent"
		echo "GUC              : $cbname"
		echo "Coordinator value: $coord"
		echo "Segment     value: $segs"
	else
		echo "WARNING: GUCS ARE OUT OF SYNC: "
		echo "GUC              : $cbname"
		echo "Coordinator value: $coord"
		echo "$segs" | sed 's/^/Segment     value: /'
	fi
	exit 0
fi

"$PG_BINDIR/psql" -X -q -t -A -F ' ' -d postgres \
	-c "SELECT content, datadir FROM gp_segment_configuration $where ORDER BY dbid" |
while read -r content datadir; do
	[ -n "$datadir" ] || continue
	if [ "$remove" -eq 1 ]; then
		# -r: the setting's lines go, and the node's default is the one taken
		grep -v -E "^[[:space:]]*$name[[:space:]]*=" "$datadir/postgresql.auto.conf" > "$datadir/postgresql.auto.conf.gpconfig"
		mv "$datadir/postgresql.auto.conf.gpconfig" "$datadir/postgresql.auto.conf"
	else
		v="$value"
		[ "$content" = -1 ] && [ -n "$cvalue" ] && v="$cvalue"
		printf "%s = '%s'\n" "$name" "$v" >> "$datadir/postgresql.auto.conf"
	fi
done
