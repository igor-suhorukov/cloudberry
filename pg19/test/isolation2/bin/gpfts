# gpfts as Cloudberry's tests call it (!\retcode gpfts -A -D) on the
# harness's cluster.  gpfts is Cloudberry's external FTS, and a build with
# the internal FTS -- Cloudberry's default, and the port's (gp_fts.c) --
# makes it a program that does nothing and exits 0 (src/bin/gpfts/fts.c),
# which is what the tests' expected outputs show.
exit 0
