# gpinitstandby as far as the isolation2 tests the port runs ask it, on the
# harness's cluster, whose nodes are all on this host, each reached by a
# socket directory of its own -- its host in gp_segment_configuration.
#
#   gpinitstandby -a -r [-P port]   the standby removed, as Cloudberry's
#       gpinitstandby removes it: from the cluster's nodes
#       (gp_remove_master_standby()), stopped, and its data directory gone
#   gpinitstandby -a -s host -S datadir [-P port]   a standby made: added to
#       the cluster's nodes (gp_add_master_standby()), a copy of the
#       coordinator made with pg_basebackup, and started streaming from it
#       as gp_walreceiver, which the coordinator's commits wait for once it
#       streams (gp_standby.c) -- a hot standby unless the harness says
#       otherwise (ISOLATION2_STANDBY_HOT), as its own standby is
#
# The coordinator is PGHOST and PGPORT's, which a test's PL/Python helper
# that runs this has from the server, started in the harness's environment.
# What is printed is Cloudberry's words for a standby initialized or removed,
# and nothing that says ERROR or FATAL where it succeeded, which a test's
# helper looks for.  Cloudberry's own gpinitstandby is gpMgmt's, which is
# M7's.
set -u

remove=0; host=; datadir=; port=
while getopts "arnDs:S:P:" opt; do
	case "$opt" in
		a|n|D) ;;
		r) remove=1 ;;
		s) host="$OPTARG" ;;
		S) datadir="$OPTARG" ;;
		P) port="$OPTARG" ;;
		*) echo "usage: gpinitstandby [-a] -r | -s host -S datadir [-P port]" >&2; exit 2 ;;
	esac
done

q() {						# on the coordinator
	"$PG_BINDIR/psql" -X -q -t -A -F '|' -d postgres -c "$1"
}

if [ "$remove" -eq 1 ]; then
	IFS='|' read -r sdir <<< "$(q "SELECT datadir FROM gp_segment_configuration WHERE content = -1 AND role = 'm'")"
	[ -n "$sdir" ] || { echo "gpinitstandby: no standby configured" >&2; exit 1; }
	q "SELECT gp_remove_master_standby()" > /dev/null ||
		{ echo "gpinitstandby: could not remove the standby from the cluster" >&2; exit 1; }
	"$PG_BINDIR/pg_ctl" -D "$sdir" -m fast -w -t 120 stop > /dev/null 2>&1
	rm -rf "$sdir"
	echo "Successfully removed standby coordinator"
	exit 0
fi

[ -n "$host" ] && [ -n "$datadir" ] ||
	{ echo "usage: gpinitstandby [-a] -r | -s host -S datadir [-P port]" >&2; exit 2; }

IFS='|' read -r chost cport cdir <<< "$(q "SELECT hostname, port, datadir FROM gp_segment_configuration WHERE content = -1 AND role = 'p'")"
[ -n "$cport" ] || { echo "gpinitstandby: could not ask the coordinator where it is" >&2; exit 1; }
port="${port:-$cport}"

dbid=$(q "SELECT gp_add_master_standby('$host', '$host', '$datadir', $port)") ||
	{ echo "gpinitstandby: could not add the standby to the cluster" >&2; exit 1; }

# The copy: the directory it goes to emptied first, as Cloudberry's
# pg_basebackup --force-overwrite empties it.
rm -rf "$datadir"
mkdir -p "$host"
"$PG_BINDIR/pg_basebackup" -D "$datadir" -h "$chost" -p "$cport" -X stream -c fast \
	> "$datadir.basebackup.log" 2>&1 ||
	{ echo "gpinitstandby: could not copy the coordinator" >&2; tail -5 "$datadir.basebackup.log" >&2; exit 1; }
{
	echo "unix_socket_directories = '$host'"
	echo "port = $port"
	echo "gp.dbid = $dbid"
	echo "hot_standby = ${ISOLATION2_STANDBY_HOT:-on}"
	echo "primary_conninfo = 'host=$chost port=$cport application_name=gp_walreceiver'"
} >> "$datadir/postgresql.auto.conf"
touch "$datadir/standby.signal"
"$PG_BINDIR/pg_ctl" -D "$datadir" -l "$datadir.log" -w -t 120 start > /dev/null 2>&1 ||
	{ echo "gpinitstandby: the standby did not start" >&2; exit 1; }
echo "Successfully created standby coordinator on $host"
