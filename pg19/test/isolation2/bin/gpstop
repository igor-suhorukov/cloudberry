# gpstop as far as the isolation2 tests the port runs ask it, on the
# harness's cluster: -a asks nothing, -f stops fast, -r starts again.  Every
# node gp_segment_configuration lists, the coordinator stopped first and
# started last, as Cloudberry's gpstop orders them; each node's log is the
# file beside its data directory, as the harness keeps it.  Cloudberry's own
# gpstop is gpMgmt's, which is M7's.
set -u

mode=smart; restart=0
while getopts "arfM:" opt; do
	case "$opt" in
		a) ;;
		r) restart=1 ;;
		f) mode=fast ;;
		M) mode="$OPTARG" ;;
		*) echo "usage: gpstop [-a] [-r] [-f] [-M mode]" >&2; exit 2 ;;
	esac
done

nodes=$("$PG_BINDIR/psql" -X -q -t -A -F ' ' -d postgres \
	-c "SELECT content, role, datadir FROM gp_segment_configuration ORDER BY content, role DESC") ||
	{ echo "gpstop: could not ask the coordinator which nodes there are" >&2; exit 1; }

# the coordinator first, then its standby, then the segments
stop_order=$(printf '%s\n' "$nodes" | awk '$1 == -1 && $2 == "p"'
             printf '%s\n' "$nodes" | awk '$1 == -1 && $2 != "p"'
             printf '%s\n' "$nodes" | awk '$1 >= 0')
printf '%s\n' "$stop_order" | while read -r content role datadir; do
	[ -n "$datadir" ] || continue
	"$PG_BINDIR/pg_ctl" -D "$datadir" -m "$mode" -w -t 120 stop > /dev/null 2>&1 ||
		{ echo "gpstop: node $content ($role) did not stop" >&2; exit 1; }
done || exit 1
[ "$restart" -eq 1 ] || exit 0

# the segments first, then the coordinator, then its standby
start_order=$(printf '%s\n' "$nodes" | awk '$1 >= 0'
              printf '%s\n' "$nodes" | awk '$1 == -1 && $2 == "p"'
              printf '%s\n' "$nodes" | awk '$1 == -1 && $2 != "p"')
printf '%s\n' "$start_order" | while read -r content role datadir; do
	[ -n "$datadir" ] || continue
	"$PG_BINDIR/pg_ctl" -D "$datadir" -l "$datadir.log" -w -t 120 start > /dev/null 2>&1 ||
		{ echo "gpstop: node $content ($role) did not start" >&2; exit 1; }
done
