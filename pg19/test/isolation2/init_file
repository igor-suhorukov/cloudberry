-- The port's additions to Cloudberry's init files, read by gpdiff.pl after
-- them.

-- start_matchignore

# ORCA's line, as gp_orca prints it.
m/^ Optimizer: GPORCA$/

# The second line of the context PostgreSQL 19 gives a lock wait inside an
# index insertion -- a cancel that arrives there, as the global deadlock
# detector's does; gpdiff.pl's -I CONTEXT: ignores the first.
m/^while inserting index tuple \(\d+,\d+\) in relation /

# The segment an error without a detail of its own came from, which the port
# gives as its DETAIL and Cloudberry after its message, where its init_file
# masks it.
m/^DETAIL:  segment \d+ \([^)]*\)(; \d+ other segments failed too)?$/

-- end_matchignore

-- start_matchsubs

# An error a segment raised with a detail of its own names the segment
# before it, and where it listens: that goes, as the greenplum suite takes
# it (see its init_file).
m/^DETAIL:  segment \d+ \([^)]*\): /
s/^DETAIL:  segment \d+ \([^)]*\): (.*?)(; \d+ other segments failed too)?$/DETAIL:  $1/

# A segment named with where it listens, as Cloudberry's init_file masks it
# for an address -- "seg0 127.0.0.1:7002 pid=5106" -- where the port's
# harness has a directory for a socket.
m/seg\d+ \/\S+:\d+ pid=\d+/
s/seg\d+ \/\S+:\d+ pid=\d+/SEG IP:PORT pid=PID/

# Where Cloudberry's error comes from, which it adds to an internal one --
# "gang was lost due to cluster reconfiguration (cdbgang_async.c:98)" -- and
# the port does not.
m/ \(cdbgang_async\.c:(\d+|LINE_NUM)\)$/
s/ \(cdbgang_async\.c:(\d+|LINE_NUM)\)$//

# PostgreSQL 19's pg_stats has the table's OID, tableid, as its third
# column, and which OID a table gets depends on what ran before it: a row of
# "SELECT * FROM pg_stats" (lockmodes) has it masked.
m/^ \w+ +\| \w+ +\| \d+ +\| \w+ +\| \d+ +\| [tf] +\| /
s/^( \w+ +\| \w+ +\| )\d+( +\| \w+ +\| \d+ +\| [tf] +\| )/$1######$2/

# A relation a segment's fragment names by OID and the segment has not --
# a session's temporary table, whose segments' parts went with its gang
# (fts_errors) -- whose OID depends on what ran before it.
m/^ERROR:  relation with OID \d+ does not exist$/
s/OID \d+/OID ######/

# A TOAST relation whose index a test made invalid (invalidated_toast_index):
# its OID, which Cloudberry's init file masks only before the source location
# Cloudberry's error ends in, "(toasting.c:...)", where PostgreSQL 19's ends.
m/^ERROR:  no valid index found for toast relation with Oid \d+$/
s/with Oid \d+$/with Oid OID/

# An OID in PostgreSQL 19's error for a view dropped while its definition was
# being read (cloudberry/README, pg_views_concurrent_drop): it changes from
# run to run.
m/^ERROR:  could not open relation with OID \d+$/
s/OID \d+/OID NNNN/

# Where Cloudberry's internal error comes from, which its test's own
# matchsubs leave as "(bmfuncs.c:XXX)" and the port's errors do not say:
# the bitmap index's pageinspect functions, gp_ao's here
# (bitmap_index_inspect), and ModifyTable's check of the segment a row was
# read on, gp_core's (modify_table_data_corrupt).
m/ \((bmfuncs|nodeModifyTable)\.c:(\d+|XXX)\)$/
s/ \((bmfuncs|nodeModifyTable)\.c:(\d+|XXX)\)$//

# A fault's PANIC: whether its message reaches the client before the
# connection closes is a race -- the client's next query may find the
# connection closed first, and libpq then says that alone -- as Cloudberry's
# own tests of a PANIC say, which take the line away themselves ("The PANIC
# message does not emit sometimes", dtx_recovery_wait_lsn): it goes from the
# expected output and the result alike, check_gxid's too.  Its message ends
# in a space, as Cloudberry's does, where Cloudberry's expected output has
# none.
m/^PANIC:  fault triggered, fault name:'\w+' fault type:'panic' ?$/
s/^PANIC:  fault triggered, fault name:'\w+' fault type:'panic' ?\n//

-- end_matchsubs
