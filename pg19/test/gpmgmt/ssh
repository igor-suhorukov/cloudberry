#
# ssh as far as gpMgmt's tools ask it, on a suite's cluster, whose nodes are
# all on this host: "ssh [options] host command" runs the command here.
# gpinitsystem's scripts, and a tool's command for another host than this
# one, reach every host by ssh, this one too; and so does a test of
# Cloudberry's: a resource group test's helper, is_session_in_group(), reads
# the cgroup.procs of a group on the host of each node of a session
# (tools.sh).
set -u

while [ "$#" -gt 0 ] && [[ "$1" == -* ]]; do
	case "$1" in
		-o|-p|-i|-l|-F|-E) shift 2 ;;
		*) shift ;;
	esac
done
[ "$#" -ge 1 ] || { echo "usage: ssh host command" >&2; exit 255; }
shift
[ "$#" -ge 1 ] || exec bash
exec bash -c "$*"
